pipeline {
    agent any

    parameters {
        choice(
            name: 'CUCUMBER_TAG',
            choices: ['@animals', '@namePrediction', '@users', '@all'],
            description: 'Feature group to execute'
        )
    }

    tools {
        maven 'Maven'
        jdk 'JDK21'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    def tag = params.CUCUMBER_TAG == '@all' ? '' : params.CUCUMBER_TAG
                    sh "mvn clean test -Dcucumber.filter.tags=${tag}"
                }
            }
        }
    }

    post {
        always {
            cucumber buildStatus: 'UNSTABLE',
                     reportTitle: "API Automation Report - ${params.CUCUMBER_TAG}",
                     fileIncludePattern: '**/cucumber.json'
        }
    }
}
